modules = ["nodejs-20", "python-3.11", "postgresql-16", "python3"]

[nix]
channel = "stable-24_05"
packages = ["at-spi2-atk", "freetype", "glib", "glibcLocales", "gtk3", "gumbo", "harfbuzz", "imagemagickBig", "jbig2dec", "libdrm", "libjpeg_turbo", "libreoffice", "libxkbcommon", "mesa", "mupdf", "openjdk", "openjpeg", "pandoc", "swig", "xcbuild", "xcodebuild", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ConvertWiz Server"

[[workflows.workflow]]
name = "ConvertWiz Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["node", "server.js"]
publicDir = "public"
